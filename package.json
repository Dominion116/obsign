{
  "name": "obsign",
  "version": "0.1.0",
  "private": true,
  "description": "Obsign — verifiable credentials with recomputable receipts, plus the Obsign Sentinel vetting agent.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "spec",
    "packages/core",
    "packages/sdk",
    "packages/platform",
    "packages/agent",
    "apps/api",
    "apps/web",
    "apps/worker",
    "cli"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "check:key-leak": "node scripts/check-key-leak.mjs",
    "freeze:vectors": "vite-node spec/tools/freeze.ts",
    "receipt:digest": "vite-node spec/tools/receipt-digest.ts",
    "build:sdk": "npm run -w @obsign/sdk build",
    "smoke:sdk": "node scripts/sdk-offline-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.10",
    "eslint": "^9.12.0",
    "mongodb-memory-server": "^10.1.2",
    "prettier": "3.9.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vite-node": "^2.1.2",
    "vitest": "^2.1.2"
  }
}
