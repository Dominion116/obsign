# Obsign environment variables (SEC-7).
# Copy to .env and fill real values. NEVER commit .env or real secrets.
# Testnet only — no mainnet value-bearing keys in this project.

# --- Persistence (cache/queue only; DB is never required to recompute, INV-4) ---
MONGODB_URI=

# --- Issuer key custody (INV-7). ---
# UNUSED IN PHASE 3: issuers are self-custodial (own wallet via RainbowKit/wagmi),
# so the platform holds NO issuer keys. This encrypted HD seed is reserved for the
# Phase 6 Sentinel agent wallet only; never logged/committed.
OBSIGN_HD_SEED=

# --- Chain (Base Sepolia) ---
BASE_SEPOLIA_RPC_URL=
CHAIN_ID=84532

# --- Contract deploy (CI deploy-testnet workflow / human; RULE-1: never local) ---
# Funded TESTNET private key used only by the deploy workflow. Never mainnet value.
DEPLOYER_PRIVATE_KEY=
# BaseScan API key for contract verification.
BASESCAN_API_KEY=

# --- Deployed contract addresses (source of truth: contracts/deployments/84532.json) ---
ANCHOR_CONTRACT_ADDRESS=0xAA5F020e5c0228612e92A21854510154790d273B
REVOCATION_CONTRACT_ADDRESS=0x7B87089d705C924a8ceb9115bb297d62BD5DAe8a
ISSUER_REGISTRY_ADDRESS=0xC75B262Ef7e6EB1d520B2929732A1CB4ba58b63a
POLICY_REGISTRY_ADDRESS=0xdf8387709cCfeFE5CE61Af1b1F70A76a4cDBf920

# --- x402 payments (Phase 4, x402 protocol v2) ---
# Testnet facilitator (Base Sepolia + Solana devnet, no key): https://x402.org/facilitator
X402_PAYEE_ADDRESS=
# Amount in the asset's ATOMIC units (USDC has 6 decimals: 10000 = 0.01 USDC).
X402_PRICE_USDC=
X402_FACILITATOR_URL=
# CAIP-2 network id (Base Sepolia). Defaults to eip155:<CHAIN_ID> when unset.
X402_NETWORK=eip155:84532
# ERC-20 asset (USDC) contract + its EIP-712 domain name/version (exact-EVM sig).
# Base Sepolia USDC:
X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_NAME=USDC
X402_ASSET_VERSION=2

# --- Worker / cron auth (SEC-4) ---
CRON_SECRET=

# --- API service (apps/api, deployed to Render) ---
# SIWE session JWT signing secret (HS256). Long random string; never committed.
SESSION_JWT_SECRET=
# Public origin of the web app: used for CORS and as the SIWE EIP-4361 domain/uri.
FRONTEND_ORIGIN=http://localhost:5173
# Hard cap on artifact-hash evidence uploads to GridFS (SEC-5). Default 5 MiB.
EVIDENCE_MAX_BYTES=5242880
# Confirmations required before an anchor/revocation is treated as indexed.
ANCHOR_MIN_CONFIRMATIONS=12
# HTTP port (Render sets this automatically; default for local runs).
PORT=8080

# --- Web app (Vite; client-exposed vars MUST be prefixed VITE_) ---
# NOTE: NEXT_PUBLIC_APP_URL below is a misnomer for this Vite SPA and is unused.
VITE_API_BASE_URL=http://localhost:8080
VITE_CHAIN_ID=84532
# WalletConnect Cloud project id for RainbowKit.
VITE_WALLETCONNECT_PROJECT_ID=

# --- LLM (Sentinel agent reasoning; strictly outside validity path, INV-5) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sentinel agent wallet (TESTNET ONLY, faucet-funded) ---
AGENT_WALLET_KEY=

# --- Web app ---
NEXT_PUBLIC_APP_URL=http://localhost:5173
