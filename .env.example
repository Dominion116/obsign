# Obsign environment variables (SEC-7).
# Copy to .env and fill real values. NEVER commit .env or real secrets.
# Testnet only — no mainnet value-bearing keys in this project.

# --- Persistence (cache/queue only; DB is never required to recompute, INV-4) ---
MONGODB_URI=

# --- Issuer key custody (INV-7). Encrypted HD seed; never logged/committed. ---
OBSIGN_HD_SEED=

# --- Chain (Base Sepolia) ---
BASE_SEPOLIA_RPC_URL=
CHAIN_ID=84532

# --- Deployed contract addresses (filled after Phase 2 deploy) ---
ANCHOR_CONTRACT_ADDRESS=
REVOCATION_CONTRACT_ADDRESS=
ISSUER_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=

# --- x402 payments (Phase 4) ---
X402_PAYEE_ADDRESS=
X402_PRICE_USDC=
X402_FACILITATOR_URL=

# --- Worker / cron auth (SEC-4) ---
CRON_SECRET=

# --- LLM (Sentinel agent reasoning; strictly outside validity path, INV-5) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sentinel agent wallet (TESTNET ONLY, faucet-funded) ---
AGENT_WALLET_KEY=

# --- Web app ---
NEXT_PUBLIC_APP_URL=http://localhost:5173
